# Copyright 2024 Pokemon Battle Arena Project
# Configuration file for storing environment variables used in the backend

# INSTRUCTIONS
# 1. Create an .env file inside the folder PokemonBattleArena
# 2. Copy the content of this file into the .env
# 3. Replace the current data with your credentials

# [DB_HOST] - Database connection host and port
# Replace with the actual host and port for your MySQL instance
DB_HOST=tcp://127.0.0.1:3306

# [DB_USER] - Username for accessing the MySQL database
# Replace with your actual MySQL username
DB_USER=your_username

# [DB_PASSWORD] - Password for the MySQL user
# Replace with the actual password for your MySQL user
DB_PASSWORD=your_password

# [DB_NAME] - Name of the MySQL database to connect to
# Replace with the name of your actual database
DB_NAME=your_database

# [ALLOWED_ORIGIN] - Specifies the allowed origin for cross-origin requests
# Change to the appropriate domain once in the production phase
ALLOWED_ORIGIN=http://localhost:5173

# [VITE_SERVER_HOST] - Base URL for the backend API server
# Used by frontend to make API requests to the correct endpoint
# This will be accessed via import.meta.env.VITE_SERVER_HOST in frontend code
VITE_SERVER_HOST=http://localhost:3000