# Copyright 2024 Pokemon Battle Arena Project
# Configuration file for storing environment variables used in the backend

# INSTRUCTIONS
# 1. Create an .env file inside the folder PokemonBattleArena
# 2. Copy the content of this file into the .env
# 3. Replace the current data with your credentials

# [Database Configuration]
# Complete PostgreSQL connection URL
# Format: jdbc:postgresql://host:port/databasename
DB_URL=jdbc:postgresql://localhost:5432/pokemon_battle_arena

# Database credentials
DB_USERNAME=user
DB_PASSWORD=password

# [Server Configuration]
# Port on which the backend server will run
SERVER_PORT=3000

# [JWT Configuration]
# Secret key used for signing JWT tokens
# Should be long and complex for security
JWT_SECRET=changeThisToALongRandomStringThatIsAtLeast64CharactersForSecurityReasons
# Token expiration time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# [CORS Configuration]
# Allowed origin for cross-origin requests
# Change to the appropriate domain for production
ALLOWED_ORIGIN=http://localhost:5173

# [Frontend Configuration]
# Base URL for the backend API server
# Used by frontend to make API requests
VITE_SERVER_HOST=http://localhost:3000/api
